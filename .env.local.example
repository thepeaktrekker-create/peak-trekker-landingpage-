# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). The service role key is SERVER-ONLY; never expose it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta Pixel (public, browser-side). Leave empty to disable tracking (dev/preview).
# Set to the Pixel ID in Vercel for Production only.
NEXT_PUBLIC_META_PIXEL_ID=
